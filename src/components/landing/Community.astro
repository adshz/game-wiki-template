---
/**
 * Community — WeChat QR card inviting readers to join the discussion group.
 * The QR image lives at /images/wechat-qr.jpg (project asset, removed from
 * forks together with the rest of the landing page by apply-template).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="section border-t border-border">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
    {/* QR card */}
    <div class="card shrink-0 p-3">
      <img
        src="/images/wechat-qr.jpg"
        alt={t.community.qrAlt}
        width="480"
        height="693"
        loading="lazy"
        decoding="async"
        class="w-40 rounded-md sm:w-44"
      />
      <p class="mt-2 flex items-center justify-center gap-1 text-xs font-medium text-nav">
        <Icon name="lucide:qr-code" class="h-3.5 w-3.5" />
        {t.community.qrCaption}
      </p>
    </div>
    {/* Copy */}
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
        <Icon name="lucide:users" class="h-3.5 w-3.5" />
        {t.community.badge}
      </span>
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl">
        {t.community.title}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {t.community.subtitle}
      </p>
      <p class="mt-3 inline-flex items-center gap-1.5 text-xs text-muted-foreground">
        <Icon name="lucide:message-circle" class="h-3.5 w-3.5" />
        {t.community.qrNote}
      </p>
    </div>
  </div>
</section>
